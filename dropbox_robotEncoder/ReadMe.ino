void ReadMe()
  {
    fw(50, 50, 1, 30, 0, 0);  // เดินหน้า fw(ความเร็วซ้าย, ความเร็วขวา, kp, ระยะทาง, ค่า offset, องศา);
    bw(50, 50, 1, 30, 0, 90);  // ถอยหลัง bw(ความเร็วซ้าย, ความเร็วขวา, kp, ระยะทาง, ค่า offset, องศา);

    rotate(50, 90, 10);        // หมุนขวา rotate(ความเร็วในการหมุน, องศา, ค่า offset);

    setServo();                // ตั้ง servo ให้พร้อมใช้งาน
    dropF();                    // วางกล่องหน้า
    dropB();                    // วางกล่อหลัง
  }